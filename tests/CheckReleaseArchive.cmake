cmake_minimum_required(VERSION 4.2.2)

# Verify the actual ZIP after extraction, including optional ordinary C/C++11
# consumers. XLOG_TEST_ROOT receives a fresh child directory, never a cleanup.
foreach(required IN ITEMS XLOG_ARCHIVE XLOG_PLATFORM XLOG_VERSION XLOG_TEST_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT XLOG_PLATFORM MATCHES "^(macos-arm64|windows-x64-mingw|linux-x64)$")
    message(FATAL_ERROR "Unsupported XLOG_PLATFORM: ${XLOG_PLATFORM}")
endif()
if(NOT XLOG_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "XLOG_VERSION must be a numeric major.minor.patch version")
endif()
if(NOT EXISTS "${XLOG_ARCHIVE}" OR IS_DIRECTORY "${XLOG_ARCHIVE}")
    message(FATAL_ERROR "Missing release ZIP: ${XLOG_ARCHIVE}")
endif()
file(REAL_PATH "${XLOG_ARCHIVE}" XLOG_ARCHIVE)
file(READ "${XLOG_ARCHIVE}" signature LIMIT 4 HEX)
if(NOT signature STREQUAL "504b0304")
    message(FATAL_ERROR "Release archive must be a ZIP file: ${XLOG_ARCHIVE}")
endif()
if(NOT DEFINED XLOG_VERIFY_CONSUMERS)
    set(XLOG_VERIFY_CONSUMERS ON)
endif()
string(REGEX MATCH "^[0-9]+" major "${XLOG_VERSION}")

set(expected_files)
set(expected_directories)
foreach(project_name IN ITEMS xlog_encode xlog_decode)
    set(metadata
        "include/${project_name}/${project_name}.h"
        "include/${project_name}/${project_name}_config.h"
        "include/${project_name}/${project_name}_types.h"
        "include/${project_name}/${project_name}_export.h"
        "cmake/${project_name}Config.cmake"
        "cmake/${project_name}ConfigVersion.cmake"
        "doc/README.md" "doc/OpenSSL-LICENSE.txt" "doc/ZLIB-LICENSE.txt")
    set(libraries)
    if(XLOG_PLATFORM STREQUAL "macos-arm64")
        list(APPEND libraries "lib/lib${project_name}.dylib"
            "lib/lib${project_name}.${major}.dylib"
            "lib/lib${project_name}.${XLOG_VERSION}.dylib")
    elseif(XLOG_PLATFORM STREQUAL "linux-x64")
        list(APPEND libraries "lib/lib${project_name}.so"
            "lib/lib${project_name}.so.${major}"
            "lib/lib${project_name}.so.${XLOG_VERSION}")
    else()
        list(APPEND libraries "lib/lib${project_name}.dll.a" "bin/lib${project_name}.dll")
    endif()
    foreach(path IN LISTS metadata libraries)
        list(APPEND expected_files "${project_name}/${path}")
    endforeach()
    list(APPEND expected_directories "${project_name}" "${project_name}/include"
        "${project_name}/include/${project_name}" "${project_name}/lib"
        "${project_name}/cmake" "${project_name}/doc")
    if(XLOG_PLATFORM STREQUAL "windows-x64-mingw")
        list(APPEND expected_directories "${project_name}/bin")
    endif()
endforeach()

# Check archive paths before extracting, then check the extracted tree as well.
# Exact lists exclude private headers, sources, modules, tests and build output.
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${XLOG_ARCHIVE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE listing ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Cannot list release ZIP:\n${error}")
endif()
string(REPLACE "\r\n" "\n" listing "${listing}")
string(REPLACE "\n" ";" entries "${listing}")
set(seen)
foreach(entry IN LISTS entries)
    if(entry STREQUAL "")
        continue()
    endif()
    if(entry MATCHES "/$")
        string(REGEX REPLACE "/$" "" directory "${entry}")
        if(NOT directory IN_LIST expected_directories)
            message(FATAL_ERROR "Unexpected release ZIP directory: ${entry}")
        endif()
    elseif(NOT entry IN_LIST expected_files)
        message(FATAL_ERROR "Unexpected release ZIP file: ${entry}")
    else()
        if(entry IN_LIST seen)
            message(FATAL_ERROR "Duplicate release ZIP file: ${entry}")
        endif()
        list(APPEND seen "${entry}")
    endif()
endforeach()
list(SORT seen)
list(SORT expected_files)
if(NOT seen STREQUAL expected_files)
    message(FATAL_ERROR "Release ZIP is missing SDK files:\nExpected: ${expected_files}\nFound: ${seen}")
endif()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
get_filename_component(test_root "${XLOG_TEST_ROOT}" ABSOLUTE)
set(work "${test_root}/archive-${nonce}")
set(extracted "${work}/extracted SDK")
file(MAKE_DIRECTORY "${extracted}")
file(ARCHIVE_EXTRACT INPUT "${XLOG_ARCHIVE}" DESTINATION "${extracted}")
file(GLOB_RECURSE actual_files LIST_DIRECTORIES FALSE RELATIVE "${extracted}" "${extracted}/*")
list(SORT actual_files)
if(NOT actual_files STREQUAL expected_files)
    message(FATAL_ERROR "Extracted SDK file list differs from the release ZIP contract")
endif()
foreach(path IN LISTS expected_files)
    if(NOT EXISTS "${extracted}/${path}" OR IS_DIRECTORY "${extracted}/${path}")
        message(FATAL_ERROR "Missing or broken extracted SDK file: ${path}")
    endif()
    file(SIZE "${extracted}/${path}" size)
    if(size EQUAL 0)
        message(FATAL_ERROR "Empty extracted SDK file: ${path}")
    endif()
    if(IS_SYMLINK "${extracted}/${path}")
        if(NOT path MATCHES "/lib/")
            message(FATAL_ERROR "Unexpected SDK metadata symlink: ${path}")
        endif()
        file(READ_SYMLINK "${extracted}/${path}" target)
        if(IS_ABSOLUTE "${target}" OR target MATCHES "[/\\\\]")
            message(FATAL_ERROR "Non-relocatable SDK library alias: ${path} -> ${target}")
        endif()
        get_filename_component(library_dir "${extracted}/${path}" DIRECTORY)
        file(REAL_PATH "${extracted}/${path}" resolved)
        cmake_path(IS_PREFIX library_dir "${resolved}" NORMALIZE inside_library)
        if(NOT inside_library)
            message(FATAL_ERROR "SDK library alias escapes its lib directory: ${path}")
        endif()
    endif()
endforeach()

foreach(project_name IN ITEMS xlog_encode xlog_decode)
    set(prefix "${extracted}/${project_name}")
    if(XLOG_PLATFORM STREQUAL "macos-arm64")
        set(library "${prefix}/lib/lib${project_name}.${XLOG_VERSION}.dylib")
        set(aliases "${prefix}/lib/lib${project_name}.dylib"
            "${prefix}/lib/lib${project_name}.${major}.dylib")
    elseif(XLOG_PLATFORM STREQUAL "linux-x64")
        set(library "${prefix}/lib/lib${project_name}.so.${XLOG_VERSION}")
        set(aliases "${prefix}/lib/lib${project_name}.so"
            "${prefix}/lib/lib${project_name}.so.${major}")
    else()
        set(aliases)
    endif()
    if(aliases)
        file(SHA256 "${library}" expected_hash)
        foreach(alias IN LISTS aliases)
            file(SHA256 "${alias}" actual_hash)
            if(NOT expected_hash STREQUAL actual_hash)
                message(FATAL_ERROR "Extracted library alias has different contents: ${alias}")
            endif()
        endforeach()
    endif()
    if(XLOG_VERIFY_CONSUMERS)
        execute_process(COMMAND "${CMAKE_COMMAND}"
            "-DXLOG_PROJECT=${project_name}" "-DXLOG_PREFIX=${prefix}"
            "-DXLOG_TEST_ROOT=${work}/consumers" -DXLOG_BUILD_TYPE=Release
            -P "${CMAKE_CURRENT_LIST_DIR}/RunPackageConsumer.cmake"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT "${result}" STREQUAL "0")
            message(FATAL_ERROR "Extracted ${project_name} consumer failed:\n${output}\n${error}")
        endif()
    endif()
endforeach()
message(STATUS "Release ZIP SDK layout and library aliases passed: ${XLOG_ARCHIVE}")
if(XLOG_VERIFY_CONSUMERS)
    message(STATUS "Extracted encode/decode SDKs passed relocated C and C++11 consumers")
endif()
file(REMOVE_RECURSE "${work}")
